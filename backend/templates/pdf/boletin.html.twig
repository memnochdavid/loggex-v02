<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 10px;
            color: #1a1a1a;
            line-height: 1.3;
        }
        .page {
            padding: 25px 35px;
            page-break-after: always;
            position: relative;
            min-height: 90%;
        }
        .page:last-child { page-break-after: avoid; }

        /* Cabecera */
        .header-table {
            width: 100%;
            border: none;
            margin-bottom: 20px;
        }
        .header-table td {
            border: none;
            vertical-align: middle;
            padding: 0;
        }
        .header-logo img {
            max-width: 120px;
            max-height: 60px;
        }
        .header-center {
            text-align: center;
        }
        .header-center .alumno-name {
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 3px;
        }
        .header-center .alumno-detail {
            font-size: 10px;
        }
        .header-center .alumno-detail b {
            font-weight: bold;
        }
        .header-right {
            text-align: right;
            font-size: 11px;
            font-weight: bold;
        }
        .header-right .subtitle {
            font-size: 9px;
            font-weight: normal;
            color: #666;
        }

        /* Tabla de calificaciones */
        .grades-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .grades-table th {
            background-color: #f0f0f0;
            padding: 5px 6px;
            text-align: center;
            font-size: 9px;
            font-weight: bold;
            border: 1px solid #999;
        }
        .grades-table th:first-child {
            text-align: left;
        }
        .grades-table td {
            padding: 4px 6px;
            border: 1px solid #ccc;
            font-size: 9px;
        }
        .grades-table td.module-name {
            text-align: left;
            font-size: 9px;
        }
        .grades-table td.center {
            text-align: center;
        }
        .grades-table td.grade {
            text-align: center;
            font-weight: bold;
        }

        /* Pie */
        .footer-section {
            margin-top: 30px;
        }
        .date-signature-table {
            width: 100%;
            border: none;
            margin-top: 20px;
        }
        .date-signature-table td {
            border: none;
            vertical-align: top;
            padding: 0;
        }
        .observations {
            font-size: 8px;
            color: #444;
            line-height: 1.5;
        }
        .observations b {
            font-weight: bold;
        }
        /* Bloque firma — stack simple, ancho fijo 180px. Nada se desborda. */
        .signature-box {
            width: 180px;
            margin: 0 0 0 auto;
            text-align: center;
        }
        .signature-box .sig-date {
            font-size: 10px;
            margin-bottom: 4px;
        }
        .signature-box .sig-img {
            width: 160px;
            height: 57px;
            margin: 0 auto;
            overflow: hidden;
        }
        .signature-box .sig-name {
            font-size: 9px;
            color: #333;
            margin-top: 2px;
        }
        .signature-box .sig-name b { font-weight: bold; }
    </style>
</head>
<body>
{% for boletin in boletines %}
    <div class="page">
        {# Cabecera #}
        <table class="header-table">
            <tr>
                <td style="width: 30%;" class="header-logo">
                    <table style="border: none; width: 100%;">
                        <tr>
                            <td style="border: none; padding: 0; vertical-align: middle; width: 50px;">
                                {% if logoUrl %}
                                    <img src="{{ logoUrl }}" style="max-width: 45px; max-height: 45px;">
                                {% endif %}
                            </td>
                            <td style="border: none; padding: 0 0 0 8px; vertical-align: middle;">
                                {% if nameTitleConfig and nameTitleConfig.words is defined and nameTitleConfig.words|length > 0 %}
                                    {% set spacing = nameTitleConfig.spacing|default('0.3rem') %}
                                    <div style="font-size: 11px; font-weight: bold; line-height: 1.3; display: inline;">
                                        {% for word in nameTitleConfig.words %}
                                            {% set wordColor = word.color|default('#000000') %}
                                            {% set safeColor = wordColor|upper in ['#FFFFFF', '#FFF', '#F8FAFC', '#F1F5F9', '#E2E8F0', '#FAFAFA', '#F5F5F5'] ? '#1a1a1a' : wordColor %}
                                            <span style="color: {{ safeColor }};{{ not loop.first ? ' margin-left: ' ~ spacing ~ ';' : '' }}">
                                                {%- if nameTitleConfig.casing|default('original') == 'uppercase' -%}
                                                    {{ word.text|upper }}
                                                {%- elseif nameTitleConfig.casing|default('original') == 'lowercase' -%}
                                                    {{ word.text|lower }}
                                                {%- else -%}
                                                    {{ word.text }}
                                                {%- endif -%}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div style="font-size: 11px; font-weight: bold;">{{ centro.nombre }}</div>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </td>
                <td style="width: 50%;" class="header-center">
                    <div class="alumno-name">{{ i18n.student }}: &nbsp; {{ boletin.alumno.apellidos|upper }} {{ boletin.alumno.nombre|upper }}</div>
                    <div class="alumno-detail"><b>{{ i18n.course }}:</b> &nbsp; {{ grupo.curso }}º {{ ciclo.nombre|upper }}</div>
                    <div class="alumno-detail"><b>{{ i18n.shift }}:</b> &nbsp; A | {{ grupo.fechaInicio }}-{{ grupo.fechaFin }}</div>
                </td>
                <td style="width: 25%;" class="header-right">
                    {{ i18n.title }}
                    <div class="subtitle">{{ grupo.anioEscolar }}</div>
                </td>
            </tr>
        </table>

        {# Tabla de calificaciones #}
        <table class="grades-table">
            <thead>
                <tr>
                    <th style="text-align: left; width: 30%;">{{ i18n.subject }}</th>
                    <th style="width: 10%;">{{ i18n.absences }}</th>
                    {% for periodo in periodos %}
                        <th>{{ periodo.nombre }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for mod in boletin.modulos %}
                <tr>
                    <td class="module-name">{{ mod.modulo }}</td>
                    <td class="center">{{ mod.faltasPct is not null ? mod.faltasPct ~ '%' : '-' }}</td>
                    {% for periodo in periodos %}
                        {% set nota = mod.notasPorPeriodo[periodo.id] is defined ? mod.notasPorPeriodo[periodo.id] : null %}
                        <td class="grade">
                            {{ nota is not null ? nota|number_format(1) : '-' }}
                        </td>
                    {% endfor %}
                </tr>
                {% endfor %}
            </tbody>
        </table>

        {# Pie: observaciones + fecha + firma #}
        <div class="footer-section">
            <table class="date-signature-table">
                <tr>
                    <td style="width: 60%;">
                        <div class="observations">
                            <b>{{ i18n.observations }}:</b><br>
                            {{ i18n.obs_text }}<br>
                            {{ i18n.np }}<br>
                            {{ i18n.na }}<br>
                            {{ i18n.ne }}
                        </div>
                    </td>
                    <td style="width: 40%; vertical-align: top;">
                        <div class="signature-box">
                            <div class="sig-date">{{ i18n.date }}: &nbsp; <b>{{ fechaEmision }}</b></div>
                            {% if firmaSvg %}
                                <div class="sig-img">
                                    <img src="{{ firmaSvg }}" alt="Firma" width="180" height="77" />
                                </div>
                            {% endif %}
                            <div class="sig-name">
                                {% if firmante %}<b>{{ firmante }}</b><br>{% endif %}
                                {{ i18n.coordinator }}
                            </div>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
{% endfor %}
</body>
</html>
