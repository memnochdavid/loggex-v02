<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 10px;
            color: #1a1a1a;
            line-height: 1.3;
        }
        .page {
            padding: 18px 28px;
            position: relative;
        }

        /* Cabecera (idéntica al boletín) */
        .header-table {
            width: 100%;
            border: none;
            margin-bottom: 14px;
        }
        .header-table td {
            border: none;
            vertical-align: middle;
            padding: 0;
        }
        .header-logo img {
            max-width: 45px;
            max-height: 45px;
        }
        .header-center {
            text-align: center;
        }
        .header-center .subject-line {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 2px;
        }
        .header-center .context-line {
            font-size: 10px;
            color: #444;
        }
        .header-right {
            text-align: right;
            font-size: 11px;
            font-weight: bold;
        }
        .header-right .subtitle {
            font-size: 9px;
            font-weight: normal;
            color: #666;
        }

        /* Parrilla */
        .turno-label {
            font-size: 10px;
            font-weight: bold;
            color: #333;
            margin: 10px 0 4px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .schedule-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
            table-layout: fixed;
        }
        .schedule-table th,
        .schedule-table td {
            border: 1px solid #999;
            padding: 4px 5px;
            font-size: 9px;
            vertical-align: top;
        }
        .schedule-table thead th {
            background-color: #f0f0f0;
            text-align: center;
            font-weight: bold;
            padding: 5px 4px;
        }
        .schedule-table .hour-cell {
            background-color: #f8f8f8;
            text-align: center;
            vertical-align: middle;
            font-weight: bold;
            font-size: 8px;
            color: #555;
            white-space: nowrap;
            width: 10%;
        }
        .schedule-table .day-cell {
            width: 18%;
            padding: 0;
            vertical-align: middle;
            text-align: center;
        }
        .event {
            border-radius: 3px;
            padding: 3px 4px;
            color: #fff;
            box-sizing: border-box;
            display: block;
            text-align: center;
        }
        .event .ev-mod {
            font-weight: bold;
            font-size: 9px;
            line-height: 1.15;
            margin-bottom: 1px;
            word-wrap: break-word;
        }
        .event .ev-meta {
            font-size: 7.5px;
            line-height: 1.2;
            opacity: 0.95;
        }
        .event .ev-group {
            font-size: 7.5px;
            line-height: 1.2;
            opacity: 0.95;
            font-style: italic;
        }
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #888;
            font-size: 12px;
            border: 1px dashed #ccc;
            margin-top: 20px;
        }

        /* Sub-cabecera de rango lectivo (solo en multi-página) */
        .pl-header {
            margin: 8px 0 6px 0;
            padding: 6px 10px;
            background: #f5f5f5;
            border-left: 4px solid #999;
            font-size: 11px;
        }
        .pl-header .pl-name {
            font-weight: bold;
            color: #1a1a1a;
        }
        .pl-header .pl-dates {
            color: #555;
            font-size: 10px;
            margin-left: 8px;
        }

        /* Salto de página entre rangos */
        .page-break { page-break-after: always; }

        /* Anexo "Otras horas curriculares" (Fase 6 modalidad-imparticion) */
        .other-hours-title {
            font-size: 13px;
            font-weight: bold;
            color: #1a1a1a;
            margin-top: 10px;
            margin-bottom: 4px;
        }
        .other-hours-subtitle {
            font-size: 9px;
            color: #666;
            margin-bottom: 10px;
            font-style: italic;
        }
        .other-hours-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
        }
        .other-hours-table th,
        .other-hours-table td {
            border: 1px solid #999;
            padding: 5px 8px;
            font-size: 10px;
            vertical-align: middle;
        }
        .other-hours-table thead th {
            background-color: #f0f0f0;
            text-align: left;
            font-weight: bold;
        }
        .other-hours-table td.col-hours {
            text-align: right;
            white-space: nowrap;
            width: 14%;
        }
        .other-hours-table td.col-modality {
            width: 16%;
        }
        .other-hours-table td.col-teacher {
            width: 22%;
            color: #444;
        }
        .modality-badge {
            display: inline-block;
            padding: 1px 7px;
            border-radius: 3px;
            font-size: 9px;
            font-weight: bold;
            color: #fff;
        }
        .modality-fct        { background-color: #6d6875; }
        .modality-no_regular { background-color: #7d6f5a; }
        .modality-autonoma   { background-color: #5b8a72; }

        /* Pie */
        .footer {
            margin-top: 14px;
            text-align: right;
            font-size: 8px;
            color: #777;
        }
    </style>
</head>
<body>
{# Macro de cabecera (común para todas las páginas) #}
{% macro headerBlock(centro, logoUrl, nameTitleConfig, subjectLine, contextLine, isPersonal, anioEscolar, fechaEmision, i18n) %}
    <table class="header-table">
        <tr>
            <td style="width: 30%;" class="header-logo">
                <table style="border: none; width: 100%;">
                    <tr>
                        <td style="border: none; padding: 0; vertical-align: middle; width: 50px;">
                            {% if logoUrl %}
                                <img src="{{ logoUrl }}" style="max-width: 45px; max-height: 45px;">
                            {% endif %}
                        </td>
                        <td style="border: none; padding: 0 0 0 8px; vertical-align: middle;">
                            {% if nameTitleConfig and nameTitleConfig.words is defined and nameTitleConfig.words|length > 0 %}
                                {% set spacing = nameTitleConfig.spacing|default('0.3rem') %}
                                <div style="font-size: 11px; font-weight: bold; line-height: 1.3; display: inline;">
                                    {% for word in nameTitleConfig.words %}
                                        {% set wordColor = word.color|default('#000000') %}
                                        {% set safeColor = wordColor|upper in ['#FFFFFF', '#FFF', '#F8FAFC', '#F1F5F9', '#E2E8F0', '#FAFAFA', '#F5F5F5'] ? '#1a1a1a' : wordColor %}
                                        <span style="color: {{ safeColor }};{{ not loop.first ? ' margin-left: ' ~ spacing ~ ';' : '' }}">
                                            {%- if nameTitleConfig.casing|default('original') == 'uppercase' -%}
                                                {{ word.text|upper }}
                                            {%- elseif nameTitleConfig.casing|default('original') == 'lowercase' -%}
                                                {{ word.text|lower }}
                                            {%- else -%}
                                                {{ word.text }}
                                            {%- endif -%}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <div style="font-size: 11px; font-weight: bold;">{{ centro.nombre }}</div>
                            {% endif %}
                        </td>
                    </tr>
                </table>
            </td>
            <td style="width: 50%;" class="header-center">
                {% if subjectLine %}
                    <div class="subject-line">{{ subjectLine }}</div>
                {% endif %}
                {% if contextLine %}
                    <div class="context-line">{{ contextLine }}</div>
                {% endif %}
            </td>
            <td style="width: 25%;" class="header-right">
                {{ isPersonal ? i18n.titlePersonal : i18n.titleGroup }}
                {% if anioEscolar %}
                    <div class="subtitle">{{ anioEscolar }}</div>
                {% endif %}
                <div class="subtitle" style="margin-top: 2px;">{{ i18n.date }}: {{ fechaEmision }}</div>
            </td>
        </tr>
    </table>
{% endmacro %}

{# Macro de parrilla (mañana + tarde) #}
{% macro grillaBlock(slotsManana, slotsTarde, matriz, diasSemana, diasLabels, isPersonal, i18n) %}
    {% set hasAny = slotsManana|length > 0 or slotsTarde|length > 0 %}
    {% if not hasAny %}
        <div class="empty-state">{{ i18n.noClasses }}</div>
    {% else %}
        {% set hasBoth = slotsManana|length > 0 and slotsTarde|length > 0 %}
        {% for bloque in [
            {'label': i18n.morning, 'slots': slotsManana, 'show': slotsManana|length > 0},
            {'label': i18n.afternoon, 'slots': slotsTarde, 'show': slotsTarde|length > 0}
        ] %}
            {% if bloque.show %}
                {% if hasBoth %}
                    <div class="turno-label">{{ bloque.label }}</div>
                {% endif %}
                <table class="schedule-table">
                    <thead>
                        <tr>
                            <th class="hour-cell">{{ i18n.time }}</th>
                            {% for d in diasSemana %}
                                <th>{{ diasLabels[d] }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {# Una fila por tramo (Fase B fix 2026-05-12). La
                           matriz se indexa por tramoKey y cada celda día
                           es una LISTA de eventos del tramo apilados en
                           orden cronológico. Sin rowspans complejos →
                           Dompdf renderiza sin "Undefined array key X". #}
                        {% for tramo in bloque.slots %}
                            {% set tramoKey = tramo.horaInicio ~ '-' ~ tramo.horaFin %}
                            {% set fila = matriz[tramoKey] is defined ? matriz[tramoKey] : {} %}
                            <tr>
                                <td class="hour-cell">
                                    {{ tramo.horaInicio }}<br>{{ tramo.horaFin }}
                                </td>
                                {% for d in diasSemana %}
                                    {% set evs = fila[d]|default([]) %}
                                    {% set solo = evs|length == 1 %}
                                    {# Cuando la celda tiene 1 evento, pintamos el FONDO del <td> con
                                       el color de la materia (no el del div interno). Razón: el
                                       <td> se estira automáticamente a la altura del <tr>, que la
                                       determina la celda más alta (a menudo otra con 2+ eventos
                                       o texto multi-línea). Sin esto, un `min-height` proporcional
                                       en el div .event se queda corto y deja hueco blanco bajo la
                                       card. Con el bg en el <td>, el color cubre toda la celda
                                       sin importar la altura final del row. #}
                                    <td class="day-cell"
                                        {% if solo %}style="background-color: {{ evs[0].color }}; color: #fff;"{% endif %}>
                                        {% for ev in evs %}
                                            {# min-height proporcional. Si la celda tiene 1 solo
                                               evento, usa la duración del tramo entero. Si tiene
                                               varios, cada uno con su duración propia. #}
                                            {% set durHi = ev.horaInicio|split(':') %}
                                            {% set durHf = ev.horaFin|split(':') %}
                                            {% set durMin = (durHf[0] * 60 + durHf[1]) - (durHi[0] * 60 + durHi[1]) %}
                                            {% set efectivoMin = solo ? tramo.durMin : durMin %}
                                            {% set minH = (efectivoMin * 0.8)|round %}
                                            <div class="event"
                                                 style="{% if solo %}background-color: transparent;{% else %}background-color: {{ ev.color }}; min-height: {{ minH < 30 ? 30 : minH }}px;{% endif %}">
                                                <div class="ev-mod">{{ ev.materia }}</div>
                                                {% if ev.profesor %}
                                                    <div class="ev-meta">{{ ev.profesor }}</div>
                                                {% endif %}
                                                {% if ev.aula %}
                                                    <div class="ev-meta">{{ i18n.classroom }}: {{ ev.aula }}</div>
                                                {% endif %}
                                                {% if isPersonal and ev.gruposLabel %}
                                                    {# `gruposLabel` viene pre-formateado del controller —
                                                       un solo grupo "1º DAW" o varios concatenados
                                                       "1º DAW + 1º DAM" cuando un bloque físico se
                                                       imparte simultáneamente a varios grupos. #}
                                                    <div class="ev-group">{{ ev.gruposLabel }}</div>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        {% endfor %}
    {% endif %}
{% endmacro %}

{% import _self as parts %}

{# Modo multi-página: una entrada por PeriodoLectivo (rango). #}
{% if paginas is defined and paginas|length > 0 %}
    {% set hasOtrasHoras = otrasHoras is defined and otrasHoras|length > 0 %}
    {% for pagina in paginas %}
        {# La última página por rango lleva page-break si después viene el
           anexo de "Otras horas". Sin él, la última es la última y no
           lleva separador. #}
        {% set needsBreak = not loop.last or hasOtrasHoras %}
        <div class="page{{ needsBreak ? ' page-break' : '' }}">
            {{ parts.headerBlock(centro, logoUrl, nameTitleConfig, subjectLine, contextLine, isPersonal, anioEscolar, fechaEmision, i18n) }}
            {% if pagina.plNombre %}
                <div class="pl-header">
                    <span class="pl-name">{{ pagina.plNombre }}</span>
                    {% if pagina.plFechaInicio and pagina.plFechaFin %}
                        <span class="pl-dates">{{ pagina.plFechaInicio }} – {{ pagina.plFechaFin }}</span>
                    {% endif %}
                </div>
            {% endif %}
            {{ parts.grillaBlock(pagina.slotsManana, pagina.slotsTarde, pagina.matriz, diasSemana, diasLabels, isPersonal, i18n) }}
            <div class="footer">{{ centro.nombre }}</div>
        </div>
    {% endfor %}

    {# Anexo: "Otras horas curriculares" (FCT, NO_REGULAR, AUTONOMA).
       Se renderiza como página adicional tras las parrillas si hay
       imparticiones no presenciales en el grupo. #}
    {% if hasOtrasHoras %}
        {% set modalityLabels = {
            'fct': i18n.modalityFct,
            'no_regular': i18n.modalityNoRegular,
            'autonoma': i18n.modalityAutonoma
        } %}
        <div class="page">
            {{ parts.headerBlock(centro, logoUrl, nameTitleConfig, subjectLine, contextLine, isPersonal, anioEscolar, fechaEmision, i18n) }}
            <div class="other-hours-title">{{ i18n.otherHoursTitle }}</div>
            <div class="other-hours-subtitle">{{ i18n.otherHoursSubtitle }}</div>
            <table class="other-hours-table">
                <thead>
                    <tr>
                        <th>{{ i18n.otherHoursSubject }}</th>
                        <th class="col-modality">{{ i18n.otherHoursModality }}</th>
                        <th class="col-hours" style="text-align: right;">{{ i18n.otherHoursHours }}</th>
                        <th class="col-teacher">{{ i18n.otherHoursTeacher }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in otrasHoras %}
                        <tr>
                            <td>{{ row.materia }}</td>
                            <td class="col-modality">
                                <span class="modality-badge modality-{{ row.modalidad }}">
                                    {{ modalityLabels[row.modalidad]|default(row.modalidad) }}
                                </span>
                            </td>
                            <td class="col-hours">
                                {% if row.horasTotales %}
                                    {{ row.horasTotales }} h
                                {% else %}
                                    {{ i18n.noHoursSet }}
                                {% endif %}
                            </td>
                            <td class="col-teacher">{{ row.profesor|default(i18n.noHoursSet) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div class="footer">{{ centro.nombre }}</div>
        </div>
    {% endif %}
{% else %}
    {# Modo single-page (compatibilidad: /horario/me). #}
    <div class="page">
        {{ parts.headerBlock(centro, logoUrl, nameTitleConfig, subjectLine, contextLine, isPersonal, anioEscolar, fechaEmision, i18n) }}
        {{ parts.grillaBlock(slotsManana, slotsTarde, matriz, diasSemana, diasLabels, isPersonal, i18n) }}
        <div class="footer">{{ centro.nombre }}</div>
    </div>
{% endif %}
</body>
</html>
