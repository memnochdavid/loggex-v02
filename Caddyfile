{
    local_certs
}

(app_routes) {
    handle /api/* {
        reverse_proxy backend:80
    }
    handle /uploads/* {
        reverse_proxy backend:80
    }
    handle {
        reverse_proxy frontend:5173
    }
}

# Puerto 80 interno (Mapeado a 8888 externo)
:80 {
    import app_routes
}

# Puerto 443 interno (Mapeado a 8443 externo) - Frontend + API
localhost:443 {
    tls internal
    import app_routes
}

# Puerto 8443 interno (Mapeado a 9443 externo) - SOLO BACKEND
localhost:8443 {
    tls internal
    reverse_proxy backend:80
}
